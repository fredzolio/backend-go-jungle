# Copy to .env to override defaults (all values below are LOCAL EXAMPLES, not secrets).
# Every variable has a default in compose.yaml, so .env is optional for local runs.

# --- Host ports (always bound to 127.0.0.1) ---
JUNGLE_HTTP_PORT=18080        # public entrypoint (API at /, Keycloak at /auth, docs at /docs)
JUNGLE_ADMIN_PORT=18090       # private entrypoint (Keycloak admin console, Traefik dashboard)
JUNGLE_PG_PORT=15432          # Postgres, for debugging and integration tests
JUNGLE_MINISTACK_PORT=14566   # MiniStack (SQS/SNS/IAM), for integration tests

# --- Public URLs (must match how clients reach the edge) ---
PUBLIC_BASE_URL=http://localhost:18080
ADMIN_BASE_URL=http://localhost:18090

# --- Bootstrap secrets (used before Terraform runs) ---
POSTGRES_PASSWORD=postgres-local
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_PASSWORD=admin-local
MINISTACK_ROOT_SECRET=test     # MiniStack root key is "test"; IAM users get generated keys
DEMO_CLIENT_SECRET=jungle-demo-local  # public secret of demo-internal / demo-provider-1 / demo-provider-2 (empty disables them)

# --- App ---
LOG_LEVEL=info
